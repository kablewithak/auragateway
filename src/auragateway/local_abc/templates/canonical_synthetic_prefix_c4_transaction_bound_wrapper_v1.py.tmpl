_REUSABLE_PREFIX_RECEIPT_SHA256 = "e6ae9dfac5653416ae02d5a8c649faa2b19a3a42529de2b1822a584335933835"
_CANONICAL_REQUEST_PAYLOAD_SHA256 = (
    "a888c17ed8e82360fdd46d0bb6833db9db2dc3fbbfb14d861f7063b271063788"
)
