def _write_json(path: Path, value: object) -> None:
    path.write_bytes(_canonical_json_bytes(value) + b"\n")


def _capture_primary_failure(primary: BaseException) -> None:
    record = {
        "status": "PRIMARY_FAILURE_CAPTURED",
        "transaction_id": _TRANSACTION_ID,
        "exception_type": type(primary).__name__,
        "safe_message": str(primary)[:1000],
    }
    try:
        _write_json(
            Path(
                "b_vs_d_cumulative_length_locked_marker_diversified_differential_"
                "primary_failure_v1.json"
            ),
            record,
        )
    except BaseException as reporting_error:
        print(
            "SECONDARY_FAILURE_REPORTING_ERROR=" + type(reporting_error).__name__,
            file=sys.stderr,
        )


def execute_bound_payload() -> None:
    admission = admit()
    _write_json(
        Path(
            "b_vs_d_cumulative_length_locked_marker_diversified_differential_"
            "transaction_bound_admission_v1.json"
        ),
        admission,
    )
    runtime_payload = base64.b64decode(_RUNTIME_PAYLOAD_B64.encode("ascii"), validate=True)
    namespace = {
        "__name__": "__main__",
        "__file__": "<b-vs-d-marker-diversified-differential-runtime>",
        "AURAGATEWAY_TRANSACTION_ID": _TRANSACTION_ID,
        "EXECUTED_RUNTIME_SCRIPT_SHA256": _RUNTIME_PAYLOAD_SHA256,
    }
    try:
        exec(
            compile(runtime_payload, "<b-vs-d-marker-diversified-differential-runtime>", "exec"),
            namespace,
            namespace,
        )
    except SystemExit as primary:
        exit_code = primary.code
        if exit_code is None:
            return
        if isinstance(exit_code, int) and exit_code == 0:
            return
        _capture_primary_failure(primary)
        raise
    except BaseException as primary:
        _capture_primary_failure(primary)
        raise


if __name__ == "__main__":
    execute_bound_payload()
