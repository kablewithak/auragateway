"""Generated P5/P6 mechanism-admission transaction-bound wrapper V1."""

from __future__ import annotations

import base64
import hashlib
import json
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

_AUTHORIZATION_B64 = "__AUTHORIZATION_B64__"
_RUNTIME_PAYLOAD_B64 = "__RUNTIME_PAYLOAD_B64__"
_TRANSACTION_ID = "__TRANSACTION_ID__"
_ISSUER_MERGE_COMMIT = "__ISSUER_MERGE_COMMIT__"
_ISSUER_SOURCE_SHA256 = "__ISSUER_SOURCE_SHA256__"
_RUNTIME_PAYLOAD_SHA256 = "__RUNTIME_PAYLOAD_SHA256__"
_GENERATOR_CONTRACT_SHA256 = "__GENERATOR_CONTRACT_SHA256__"

_RECONCILIATION_RECORD_SHA256 = "06b20e84a01e41a3952399d430adf5a6923eaefe79b559f0f8412c180655fc4f"
_BEHAVIOR_IMPLEMENTATION_MERGE_COMMIT = "2b1841aee4397ae0c72bad6b2c9e7069835d8399"
_BEHAVIOR_IMPLEMENTATION_REVIEW_SHA256 = (
    "3a5eebca0bb53439309456b19464fb7b0a707e6c0274e3fae2144fa9ccb35330"
)
_MECHANISM_ADMISSION_CONTRACT_SHA256 = (
    "95948be1f9487dbfc650efd11b4789a4f3c60302c7cc9e38e2e1c271076684d8"
)


def _canonical_json_bytes(value: object) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def _sha256(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def _parse_time(value: str) -> datetime:
    observed = datetime.fromisoformat(value)
    if observed.tzinfo is None or observed.utcoffset() is None:
        raise RuntimeError("authorization timestamp must be timezone-aware")
    return observed.astimezone(UTC)


def _observed_gpu_count() -> int:
    completed = subprocess.run(
        ["nvidia-smi", "-L"],
        check=False,
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0:
        raise RuntimeError("unable to observe GPU topology")
    return sum(1 for line in completed.stdout.splitlines() if line.strip().startswith("GPU "))


def _decode_authorization() -> tuple[dict[str, object], bytes]:
    payload = base64.b64decode(_AUTHORIZATION_B64.encode("ascii"), validate=True)
    parsed = json.loads(payload)
    if not isinstance(parsed, dict):
        raise RuntimeError("embedded authorization must be one JSON object")
    if _canonical_json_bytes(parsed) != payload:
        raise RuntimeError("embedded authorization is not canonical")
    return parsed, payload


def admit(now: datetime | None = None) -> dict[str, object]:
    envelope, _ = _decode_authorization()
    transaction_id = envelope.get("transaction_id")
    authorization = envelope.get("authorization")
    if transaction_id != _TRANSACTION_ID or not isinstance(authorization, dict):
        raise RuntimeError("embedded authorization envelope drifted")

    canonical_authorization = _canonical_json_bytes(authorization)
    runtime_payload = base64.b64decode(
        _RUNTIME_PAYLOAD_B64.encode("ascii"),
        validate=True,
    )
    required = {
        "schema_version": "1.0.0",
        "decision": "AUTHORIZED",
        "lifecycle": "ISSUED",
        "scope": "P5_P6_MECHANISM_ADMISSION_SUCCESSOR_V1",
        "issuer_merge_commit": _ISSUER_MERGE_COMMIT,
        "reconciliation_record_sha256": _RECONCILIATION_RECORD_SHA256,
        "behavior_implementation_merge_commit": _BEHAVIOR_IMPLEMENTATION_MERGE_COMMIT,
        "behavior_implementation_review_sha256": _BEHAVIOR_IMPLEMENTATION_REVIEW_SHA256,
        "mechanism_admission_contract_sha256": _MECHANISM_ADMISSION_CONTRACT_SHA256,
        "issuer_source_sha256": _ISSUER_SOURCE_SHA256,
        "runtime_payload_sha256": _RUNTIME_PAYLOAD_SHA256,
        "generator_contract_sha256": _GENERATOR_CONTRACT_SHA256,
        "platform_observation_control_id": ("PERSIST_DURABLE_OBSERVATION_BEFORE_SAVE_AND_RUN_ALL"),
        "durable_platform_observation_required": True,
        "runtime_execution_authorized": True,
        "mechanism_admission_execution_authorized": True,
        "single_use": True,
        "every_terminal_attempt_consumes_authorization": True,
        "unchanged_replay_authorized": False,
        "authorization_reusable": False,
        "runtime_anti_replay_established": False,
        "repository_acceptance_established": False,
        "pilot_execution_authorized": False,
        "final_measured_abc_execution_authorized": False,
    }
    drift = tuple(key for key, expected in required.items() if authorization.get(key) != expected)
    if drift:
        raise RuntimeError("embedded authorization contract drift: " + ",".join(drift))

    if _sha256(canonical_authorization) != _TRANSACTION_ID:
        raise RuntimeError("transaction identity mismatch")
    if _sha256(runtime_payload) != _RUNTIME_PAYLOAD_SHA256:
        raise RuntimeError("runtime payload identity mismatch")

    budget = authorization.get("budget")
    expected_budget = {
        "maximum_benchmark_trajectory_requests": 0,
        "maximum_external_network_requests": 0,
        "maximum_external_spend": 0,
        "maximum_hidden_retries": 0,
        "maximum_kaggle_sessions": 1,
        "maximum_model_loads": 3,
        "maximum_model_requests": 6,
        "maximum_output_tokens_per_request": 32,
        "maximum_replacement_workers": 0,
        "maximum_runtime_import_closure_probes": 1,
        "maximum_runtime_install_attempts": 1,
        "maximum_save_and_run_all_actions": 1,
        "maximum_worker_starts": 3,
        "maximum_worker_teardowns": 3,
    }
    if budget != expected_budget:
        raise RuntimeError("execution budget drifted")

    mechanism = authorization.get("mechanism")
    expected_mechanism = {
        "finish_reason_stop_required": True,
        "invalid_json_blocks_mechanism": False,
        "p5_acceptance_relaxed": False,
        "p5_uses_semantic_state": False,
        "p6_acceptance_relaxed": False,
        "p6_uses_semantic_state": False,
        "raw_output_logging_permitted": False,
        "response_content_digest_required": True,
        "semantic_mismatch_blocks_mechanism": False,
        "semantic_states": [
            "EXACT_MATCH",
            "VALID_JSON_MISMATCH",
            "NON_OBJECT_JSON",
            "INVALID_JSON",
        ],
    }
    if mechanism != expected_mechanism:
        raise RuntimeError("mechanism-admission contract drifted")

    required_platform = authorization.get("required_platform")
    expected_platform = {
        "accelerator": "T4_X2",
        "allocated_gpu_count": 2,
        "credentials_permitted": False,
        "customer_data_permitted": False,
        "external_network_access_permitted": False,
        "fresh_post_artifact_observation_required": True,
        "internet_enabled": False,
        "machine_observable_runtime_topology_check_required": True,
        "observation_mounted_as_runtime_input": False,
        "observation_precedes_save_and_run_all": True,
        "preissuance_platform_observation_required": False,
    }
    if required_platform != expected_platform:
        raise RuntimeError("required platform policy drifted")

    observed = (now or datetime.now(UTC)).astimezone(UTC)
    issued_at = _parse_time(str(authorization["issued_at"]))
    expires_at = _parse_time(str(authorization["expires_at"]))
    if observed < issued_at or observed >= expires_at:
        raise RuntimeError("authorization is outside live admission window")
    if _observed_gpu_count() != 2:
        raise RuntimeError("machine-observable GPU topology does not match authorization")

    return {
        "status": "P5_P6_MECHANISM_ADMISSION_TRANSACTION_BOUND_RUNTIME_ADMISSION_VALID",
        "transaction_id": _TRANSACTION_ID,
        "issuer_merge_commit": _ISSUER_MERGE_COMMIT,
        "runtime_payload_sha256": _RUNTIME_PAYLOAD_SHA256,
        "authorization_live_at_admission": True,
        "observed_gpu_count": 2,
        "internet_policy_bound": True,
        "network_probe_performed": False,
        "platform_observation_receipt_runtime_input": False,
    }


def _write_json(path: Path, value: object) -> None:
    path.write_bytes(_canonical_json_bytes(value) + b"\n")


def _record_primary_failure(primary: BaseException) -> None:
    record = {
        "status": "PRIMARY_FAILURE_CAPTURED",
        "transaction_id": _TRANSACTION_ID,
        "exception_type": type(primary).__name__,
        "safe_message": str(primary)[:1000],
    }
    try:
        _write_json(
            Path("p5_p6_mechanism_admission_transaction_bound_primary_failure_v1.json"),
            record,
        )
    except BaseException as reporting_error:
        print(
            "SECONDARY_FAILURE_REPORTING_ERROR=" + type(reporting_error).__name__,
            file=sys.stderr,
        )


def execute_bound_payload() -> None:
    admission = admit()
    _write_json(
        Path("p5_p6_mechanism_admission_transaction_bound_admission_v1.json"),
        admission,
    )
    runtime_payload = base64.b64decode(
        _RUNTIME_PAYLOAD_B64.encode("ascii"),
        validate=True,
    )
    namespace = {
        "__name__": "__main__",
        "__file__": "<p5-p6-mechanism-admission-runtime>",
        "AURAGATEWAY_TRANSACTION_ID": _TRANSACTION_ID,
        "EXECUTED_RUNTIME_SCRIPT_SHA256": _RUNTIME_PAYLOAD_SHA256,
    }
    try:
        exec(
            compile(
                runtime_payload,
                "<p5-p6-mechanism-admission-runtime>",
                "exec",
            ),
            namespace,
            namespace,
        )
    except SystemExit as primary:
        if primary.code in (None, 0):
            print("AURAGATEWAY_BOUND_RUNTIME_EXIT=0")
            return
        _record_primary_failure(primary)
        raise
    except BaseException as primary:
        _record_primary_failure(primary)
        raise


if __name__ == "__main__":
    execute_bound_payload()
