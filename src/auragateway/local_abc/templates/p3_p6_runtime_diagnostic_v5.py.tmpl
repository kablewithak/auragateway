def cleanup_scratch() -> dict[str, object]:
    before = directory_snapshot(SCRATCH_ROOT)
    status = "PASSED"
    error_type = None
    safe_message = None
    try:
        if SCRATCH_ROOT.exists():
            shutil.rmtree(SCRATCH_ROOT)
    except OSError as error:
        status = "FAILED"
        error_type = type(error).__name__
        safe_message = sanitize_excerpt(str(error))
    report = {
        "schema_version": "1.0.0",
        "report_id": "auragateway-p3-p6-scratch-cleanup-v5",
        "status": status,
        "scratch_before": before,
        "scratch_exists_after": SCRATCH_ROOT.exists(),
        "error_type": error_type,
        "safe_message": safe_message,
    }
    write_json(OUTPUT_ROOT / "scratch_cleanup_report_v5.json", report)
    return report


def main() -> int:
    if OUTPUT_ROOT.exists() or SCRATCH_ROOT.exists() or EVIDENCE_ZIP.exists():
        raise RuntimeError("P3-P6 V5 output or scratch path already exists")
    OUTPUT_ROOT.mkdir(parents=True)
    LOG_ROOT.mkdir()
    SCRATCH_ROOT.mkdir()
    counters = {
        "kaggle_sessions": 1,
        "runtime_install_attempts": 0,
        "runtime_import_closure_probes": 0,
        "model_loads": 0,
        "worker_starts": 0,
        "model_requests": 0,
        "benchmark_trajectory_requests": 0,
        "network_requests": 0,
        "hidden_retries": 0,
        "external_spend": 0,
    }
    completed: list[str] = []
    teardown_reports: list[dict[str, object]] = []
    worker_1: Worker | None = None
    worker_2: Worker | None = None
    failure: dict[str, object] | None = None
    p6_checkpoint: dict[str, object] | None = None
    terminal = "P3_P6_RUNTIME_DIAGNOSTIC_V5_FAILED"
    active_failure_code = "P3_P6_RUNTIME_SOURCE_IDENTITY_MISMATCH"
    failed_probe: str | None = None
    try:
        write_runtime_source_identity_report()

        active_failure_code = "P3_P6_PRIVACY_BOUNDARY_VIOLATION"
        require_private_environment()

        active_failure_code = "P3_P6_WHEELHOUSE_INVALID"
        wheelhouse = discover_one_directory(RUNTIME_OUTPUT_DIRECTORY)
        validate_wheelhouse(wheelhouse)

        active_failure_code = "P3_P6_MODEL_IDENTITY_MISMATCH"
        source_snapshot = discover_model_snapshot()

        active_failure_code = "P3_P6_RUNTIME_INSTALL_FAILED"
        install_runtime(wheelhouse, counters)

        active_failure_code = "P3_P6_PLATFORM_IDENTITY_MISMATCH"
        runtime_identity = validate_target_runtime()

        active_failure_code = (
            "P3_P6_RUNTIME_PROCESS_TREE_IMPORT_CLOSURE_FAILED"
        )
        import_closure = validate_process_tree_import_closure(counters)

        active_failure_code = "P3_P6_MODEL_IDENTITY_MISMATCH"
        model_home, snapshot = prepare_model_home(source_snapshot)

        failed_probe = "P3"
        active_failure_code = "P3_P6_WORKER_STARTUP_FAILED"
        worker_1 = Worker(
            "worker_1",
            0,
            8001,
            model_home,
            snapshot,
            generation=1,
        )
        worker_1.start(counters)
        worker_1.wait_ready()

        active_failure_code = "P3_P6_MODEL_INVENTORY_MISMATCH"
        worker_1.validate_model()

        active_failure_code = "P3_P6_EXPLICIT_BACKEND_NOT_REALIZED"
        worker_1.wait_backend_marker()
        p3 = {
            "schema_version": "1.0.0",
            "probe_id": "P3",
            "status": "PASSED",
            "decision": "ONE_WORKER_TRITON_STARTUP_PASSED",
            "runtime_identity": runtime_identity,
            "runtime_import_closure": import_closure,
            "worker": worker_1.report(),
            "model_repository": MODEL_REPOSITORY,
            "model_revision": MODEL_REVISION,
            "tokenizer_revision": MODEL_REVISION,
        }
        write_json(OUTPUT_ROOT / "p3_worker_startup_report_v5.json", p3)
        completed.append("P3")

        failed_probe = "P4"
        active_failure_code = "P3_P6_REQUEST_FAILED"
        cold = run_structured_request(
            worker_1,
            '{"probe":"cold","value":1}',
            counters,
        )
        p4 = {
            "schema_version": "1.0.0",
            "probe_id": "P4",
            "status": "PASSED",
            "decision": "ONE_REQUEST_RUNTIME_COMPATIBILITY_PASSED",
            "request": cold,
            "raw_prompt_logged": False,
            "raw_output_logged": False,
        }
        write_json(
            OUTPUT_ROOT / "p4_deterministic_request_report_v5.json",
            p4,
        )
        completed.append("P4")

        failed_probe = "P5"
        active_failure_code = "P3_P6_METRIC_SEMANTIC_UNAVAILABLE"
        warm = run_structured_request(
            worker_1,
            '{"probe":"warm","value":2}',
            counters,
        )
        cold_delta = cold["metric_delta"]
        warm_delta = warm["metric_delta"]
        if not isinstance(cold_delta, dict) or not isinstance(warm_delta, dict):
            raise RuntimeError("P5 metric delta shape is invalid")
        active_failure_code = "P3_P6_CACHE_REUSE_NOT_OBSERVED"
        if float(cold_delta["cached_prefix_tokens"]) != 0:
            raise RuntimeError("cold request unexpectedly observed cached tokens")
        if float(warm_delta["cached_prefix_tokens"]) <= 0:
            raise RuntimeError("warm request did not observe cached prefix tokens")
        if (
            float(warm_delta["newly_computed_prefill_tokens"])
            >= float(cold_delta["newly_computed_prefill_tokens"])
        ):
            raise RuntimeError("warm request did not reduce computed prefill tokens")

        active_failure_code = "P3_P6_RESET_NOT_PROVEN"
        old_pid = worker_1.process.pid if worker_1.process is not None else None
        reset_teardown = worker_1.stop_and_report("P5_FULL_RESTART")
        teardown_reports.append(reset_teardown)
        if reset_teardown["status"] != "PASSED":
            raise DiagnosticFailure(
                "P3_P6_WORKER_TEARDOWN_FAILED",
                "P5 worker teardown proof failed",
            )
        worker_1 = Worker(
            "worker_1",
            0,
            8001,
            model_home,
            snapshot,
            generation=2,
        )
        worker_1.start(counters)
        worker_1.wait_ready()
        worker_1.validate_model()
        worker_1.wait_backend_marker()
        new_pid = worker_1.process.pid if worker_1.process is not None else None
        if old_pid is None or new_pid is None or old_pid == new_pid:
            raise RuntimeError("full restart did not create a new worker process")
        post_reset = run_structured_request(
            worker_1,
            '{"probe":"post-reset","value":3}',
            counters,
        )
        post_delta = post_reset["metric_delta"]
        if not isinstance(post_delta, dict):
            raise RuntimeError("post-reset metric delta shape is invalid")
        if float(post_delta["cached_prefix_tokens"]) != 0:
            raise RuntimeError("post-reset request retained cached prefix tokens")
        if float(post_delta["newly_computed_prefill_tokens"]) <= 0:
            raise RuntimeError("post-reset request did not recompute prefill tokens")
        p5 = {
            "schema_version": "1.0.0",
            "probe_id": "P5",
            "status": "PASSED",
            "decision": "CACHE_SMOKE_AND_RESET_PASSED",
            "cold_request": cold,
            "warm_request": warm,
            "post_reset_request": post_reset,
            "old_worker_pid": old_pid,
            "new_worker_pid": new_pid,
            "same_worker_prefix_reuse_proven": True,
            "full_process_restart_reset_proven": True,
            "reset_teardown": reset_teardown,
            "namespace_only_reset_used": False,
        }
        write_json(
            OUTPUT_ROOT / "p5_prefix_cache_reset_report_v5.json",
            p5,
        )
        completed.append("P5")

        failed_probe = "P6"
        p6_checkpoint = new_p6_checkpoint(counters)
        persist_p6_checkpoint(
            p6_checkpoint,
            "P6_STARTED",
            counters,
        )
        active_failure_code = "P6_WORKER_2_STARTUP_FAILED"
        worker_2 = Worker(
            "worker_2",
            1,
            8002,
            model_home,
            snapshot,
            generation=1,
        )
        worker_2.start(counters)
        worker_2.wait_ready()
        worker_2.validate_model()
        worker_2.wait_backend_marker()
        persist_p6_checkpoint(
            p6_checkpoint,
            "WORKER_2_READY",
            counters,
            {"worker_instance_id": worker_2.instance_id},
        )

        if worker_1.port == worker_2.port:
            raise DiagnosticFailure(
                "P6_PORT_ISOLATION_FAILED",
                "worker ports are not distinct",
            )
        persist_p6_checkpoint(
            p6_checkpoint,
            "PORT_ISOLATION_VALIDATED",
            counters,
            {"worker_1_port": worker_1.port, "worker_2_port": worker_2.port},
        )

        active_failure_code = "P6_PROCESS_ISOLATION_FAILED"
        process_isolation = validate_process_isolation(worker_1, worker_2)
        persist_p6_checkpoint(
            p6_checkpoint,
            "PROCESS_ISOLATION_VALIDATED",
            counters,
            process_isolation,
        )

        active_failure_code = "P6_GPU_ISOLATION_FAILED"
        gpu_isolation = validate_gpu_isolation(worker_1, worker_2)
        persist_p6_checkpoint(
            p6_checkpoint,
            "GPU_ISOLATION_VALIDATED",
            counters,
            gpu_isolation,
        )

        active_failure_code = "P3_P6_NATIVE_ORIGIN_CLOSURE_FAILED"
        native_origins = validate_native_origin_closure(worker_1, worker_2)
        write_json(
            OUTPUT_ROOT / "runtime_native_origin_report_v5.json",
            native_origins,
        )
        persist_p6_checkpoint(
            p6_checkpoint,
            "NATIVE_ORIGIN_CLOSURE_VALIDATED",
            counters,
            {"status": native_origins["status"]},
        )

        routing = route_isolation(
            worker_1,
            worker_2,
            counters,
            p6_checkpoint,
        )
        p6_checkpoint["status"] = "PASSED"
        persist_p6_checkpoint(
            p6_checkpoint,
            "P6_COMPLETED",
            counters,
            {"route_and_metric_isolation": True},
        )
        p6 = {
            "schema_version": "1.0.0",
            "probe_id": "P6",
            "status": "PASSED",
            "decision": "DUAL_WORKER_DIAGNOSTIC_PASSED",
            "worker_1": worker_1.report(),
            "worker_2": worker_2.report(),
            "process_isolation": process_isolation,
            "gpu_isolation": gpu_isolation,
            "native_origin_closure": native_origins,
            "route_and_metric_isolation": routing,
            "ports_distinct": True,
            "worker_ids_distinct": True,
            "model_semantics_used_as_route_proof": False,
        }
        write_json(
            OUTPUT_ROOT / "p6_dual_worker_isolation_report_v5.json",
            p6,
        )
        completed.append("P6")
        failed_probe = None
        terminal = "P3_P6_RUNTIME_DIAGNOSTIC_V5_PASSED"
    except Exception as error:
        if isinstance(error, DiagnosticFailure):
            error_code = error.error_code
            safe_message = error.safe_message
        else:
            error_code = active_failure_code
            safe_message = sanitize_excerpt(str(error))[:512] or type(error).__name__
        if p6_checkpoint is not None:
            p6_checkpoint["status"] = "FAILED"
            p6_checkpoint["failure_code"] = error_code
            try:
                persist_p6_checkpoint(
                    p6_checkpoint,
                    "P6_FAILED",
                    counters,
                    {"failure_code": error_code},
                )
            except Exception:
                error_code = "P6_CHECKPOINT_SERIALIZATION_FAILED"
                safe_message = "P6 checkpoint serialization failed"
        failure = {
            "schema_version": "1.0.0",
            "status": "FAILED",
            "failed_after": completed,
            "failed_probe": failed_probe,
            "error_code": error_code,
            "error_type": type(error).__name__,
            "safe_message": safe_message,
        }
    finally:
        if worker_2 is not None:
            report = worker_2.stop_and_report("TERMINAL_FINALIZATION")
            if report not in teardown_reports:
                teardown_reports.append(report)
        if worker_1 is not None:
            report = worker_1.stop_and_report("TERMINAL_FINALIZATION")
            if report not in teardown_reports:
                teardown_reports.append(report)

    teardown_failures = tuple(
        item
        for item in teardown_reports
        if item.get("status") not in {"PASSED", "NOT_STARTED"}
    )
    teardown_status = (
        "NOT_RUN"
        if not teardown_reports
        else "FAILED" if teardown_failures else "PASSED"
    )
    write_json(
        OUTPUT_ROOT / "worker_teardown_report_v5.json",
        {
            "schema_version": "1.0.0",
            "report_id": "auragateway-p3-p6-worker-teardown-report-v5",
            "status": teardown_status,
            "worker_teardowns": teardown_reports,
            "all_capture_threads_finalized": (
                not teardown_failures
                and all(
                    bool(item.get("capture_threads_finalized", True))
                    for item in teardown_reports
                )
            ),
            "all_ports_closed": (
                not teardown_failures
                and all(
                    bool(item.get("port_closed_after", True))
                    for item in teardown_reports
                )
            ),
            "all_gpu_processes_absent": (
                not teardown_failures
                and all(
                    bool(item.get("gpu_processes_absent_after", True))
                    for item in teardown_reports
                )
            ),
        },
    )

    if teardown_failures:
        terminal = "P3_P6_RUNTIME_DIAGNOSTIC_V5_FAILED"
        if failure is None:
            failure = {
                "schema_version": "1.0.0",
                "status": "FAILED",
                "failed_after": completed,
                "failed_probe": None,
                "error_code": "P3_P6_WORKER_TEARDOWN_FAILED",
                "error_type": "WorkerTeardownFailure",
                "safe_message": "one or more worker teardown proofs failed",
            }
        else:
            failure["secondary_teardown_failure"] = True

    if failure is not None:
        if worker_1 is not None:
            failure["worker_1_diagnostics"] = (
                worker_1.failure_diagnostics()
            )
        if worker_2 is not None:
            failure["worker_2_diagnostics"] = (
                worker_2.failure_diagnostics()
            )
        failure["teardown_status"] = teardown_status

    passed = (
        completed == ["P3", "P4", "P5", "P6"]
        and failure is None
        and teardown_status == "PASSED"
    )
    expected_counters = {
        "runtime_install_attempts": 1,
        "runtime_import_closure_probes": 1,
        "model_loads": 3,
        "worker_starts": 3,
        "model_requests": 5,
        "benchmark_trajectory_requests": 0,
        "network_requests": 0,
        "hidden_retries": 0,
        "external_spend": 0,
    }
    if passed:
        for name, expected in expected_counters.items():
            if counters[name] != expected:
                passed = False
                terminal = "P3_P6_RUNTIME_DIAGNOSTIC_V5_FAILED"
                failure = {
                    "schema_version": "1.0.0",
                    "status": "FAILED",
                    "failed_after": completed,
                    "failed_probe": None,
                    "error_code": "P3_P6_ACTION_BUDGET_EXCEEDED",
                    "error_type": "ActionBudgetDrift",
                    "safe_message": (
                        f"{name} expected {expected}, observed {counters[name]}"
                    ),
                    "teardown_status": teardown_status,
                }
                break

    failure_code = None if failure is None else str(failure["error_code"])
    ensure_runtime_source_identity_report(failure_code)
    ensure_install_report(failure_code)
    ensure_import_closure_report(failure_code)
    native_origin_path = OUTPUT_ROOT / "runtime_native_origin_report_v5.json"
    if not native_origin_path.is_file():
        write_json(
            native_origin_path,
            {
                "schema_version": "1.0.0",
                "report_id": "auragateway-p3-p6-runtime-native-origin-v5",
                "status": "NOT_RUN",
                "decision": "RUNTIME_NATIVE_ORIGIN_CLOSURE_NOT_RUN",
                "blocked_by": failure_code or "UPSTREAM_PRECONDITION",
                "observations": [],
                "rejected_origin_count": 0,
                "cuda_stub_origin_observed": False,
            },
        )
    checkpoint_path = OUTPUT_ROOT / "p6_stage_checkpoint_report_v5.json"
    if not checkpoint_path.is_file():
        write_json(
            checkpoint_path,
            {
                "schema_version": "1.0.0",
                "probe_id": "P6",
                "status": "NOT_RUN",
                "current_stage": "P6_NOT_STARTED",
                "events": [],
                "worker_request_counters": {
                    "worker_1": {"attempted": 0, "completed": 0},
                    "worker_2": {"attempted": 0, "completed": 0},
                },
                "global_model_requests": counters["model_requests"],
                "blocked_by": failure_code or "UPSTREAM_PRECONDITION",
                "raw_prompt_logged": False,
                "raw_output_logged": False,
            },
        )
    write_probe_terminal_reports(completed, failed_probe, failure_code, counters)

    cleanup = cleanup_scratch()
    if cleanup["status"] != "PASSED":
        passed = False
        terminal = "P3_P6_RUNTIME_DIAGNOSTIC_V5_FAILED"
        if failure is None:
            failure = {
                "schema_version": "1.0.0",
                "status": "FAILED",
                "failed_after": completed,
                "failed_probe": None,
                "error_code": "P3_P6_SCRATCH_CLEANUP_FAILED",
                "error_type": cleanup["error_type"],
                "safe_message": cleanup["safe_message"],
                "teardown_status": teardown_status,
            }
        else:
            failure["secondary_scratch_cleanup_failure"] = True

    if passed and failure is None:
        write_json(
            OUTPUT_ROOT / "failure_report_v5.json",
            {
                "schema_version": "1.0.0",
                "status": "NOT_APPLICABLE",
                "error_code": None,
                "error_type": None,
                "safe_message": None,
                "failed_after": completed,
                "failed_probe": None,
                "teardown_status": teardown_status,
            },
        )
    elif failure is not None:
        write_json(OUTPUT_ROOT / "failure_report_v5.json", failure)

    source_identity_report = json.loads(
        (
            OUTPUT_ROOT / "runtime_source_identity_report_v5.json"
        ).read_text(encoding="utf-8")
    )
    install_report = json.loads(
        (OUTPUT_ROOT / "runtime_install_report_v5.json").read_text(
            encoding="utf-8"
        )
    )
    import_closure_report = json.loads(
        (
            OUTPUT_ROOT / "runtime_import_closure_report_v5.json"
        ).read_text(encoding="utf-8")
    )
    summary = {
        "schema_version": "1.0.0",
        "diagnostic_id": "auragateway-cu129-p3-p6-runtime-diagnostic-v5",
        "source_main_commit": SOURCE_MAIN_COMMIT,
        "failure_acceptance_record_sha256": FAILURE_ACCEPTANCE_RECORD_SHA256,
        "failure_acceptance_review_sha256": FAILURE_ACCEPTANCE_REVIEW_SHA256,
        "v4_implementation_record_sha256": V4_IMPLEMENTATION_RECORD_SHA256,
        "executed_runtime_script_sha256": (
            source_identity_report.get("executed_runtime_script_sha256")
        ),
        "runtime_source_identity_status": source_identity_report["status"],
        "status": "PASSED" if passed else "FAILED",
        "terminal_decision": terminal,
        "completed_probes": completed,
        "failure_code": None if failure is None else failure["error_code"],
        "failed_probe": None if failure is None else failure.get("failed_probe"),
        "runtime_install_status": install_report["status"],
        "runtime_install_process_outcome": install_report["process_outcome"],
        "runtime_install_failure_signals": install_report.get(
            "failure_signals",
            [],
        ),
        "runtime_import_closure_status": import_closure_report["status"],
        "runtime_import_closure_process_outcome": (
            import_closure_report["process_outcome"]
        ),
        "worker_teardown_status": teardown_status,
        "p6_checkpoint_status": (
            None if p6_checkpoint is None else p6_checkpoint.get("status")
        ),
        "stop_on_first_failure": True,
        "counters": counters,
        "scratch_cleanup_status": cleanup["status"],
        "scratch_exists_after_cleanup": cleanup["scratch_exists_after"],
        "credentials_used": False,
        "customer_data_present": False,
        "network_access_permitted": False,
        "measured_abc_execution_performed": False,
        "next_gate": (
            "preserve_and_accept_p3_p6_runtime_diagnostic_v5"
            if passed
            else "preserve_and_classify_p3_p6_runtime_failure_v5"
        ),
    }
    write_json(
        OUTPUT_ROOT / "p3_p6_runtime_diagnostic_summary_v5.json",
        summary,
    )
    human = (
        "# AuraGateway P3-P6 Runtime Diagnostic V5\n\n"
        f"- Status: {summary['status']}\n"
        f"- Terminal decision: {terminal}\n"
        f"- Runtime source identity: "
        f"{summary['runtime_source_identity_status']}\n"
        f"- Runtime install: {summary['runtime_install_process_outcome']}\n"
        f"- Import closure: {summary['runtime_import_closure_status']}\n"
        f"- Worker teardown: {summary['worker_teardown_status']}\n"
        f"- Completed probes: {', '.join(completed) or 'none'}\n"
        f"- Scratch cleanup: {summary['scratch_cleanup_status']}\n"
        "- Model requests are synthetic and bounded.\n"
        "- No A/B/C benchmark trajectory was executed.\n"
        "- Deployment and production readiness are not claimed.\n"
    )
    write_text(OUTPUT_ROOT / "human_report_v5.md", human)
    bundle = bundle_outputs()
    terminal_payload = {
        **summary,
        **bundle,
    }
    print(canonical_json(terminal_payload))
    return 0 if passed else 2


if __name__ == "__main__":
    raise SystemExit(main())
