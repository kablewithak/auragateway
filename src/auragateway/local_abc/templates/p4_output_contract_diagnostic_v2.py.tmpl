        "runtime_native_origin_report_v2.json": {"schema_version": "1.0.0", "status": "NOT_RUN"},
        "worker_startup_report_v2.json": {"schema_version": "1.0.0", "status": "NOT_RUN"},
        "request_results_v2.json": {"schema_version": "1.0.0", "status": "NOT_RUN", "results": []},
        "case_metrics_v2.json": {"schema_version": "1.0.0", "status": "NOT_RUN", "cases": []},
