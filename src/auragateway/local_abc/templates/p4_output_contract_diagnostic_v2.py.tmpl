def write_request_evidence(results: list[dict[str, object]]) -> None:
    status = "COMPLETE" if len(results) == len(REQUEST_ORDER) else ("PARTIAL" if results else "NOT_RUN")
    write_json("request_results_v2.json", {
        "schema_version": "1.0.0",
        "status": status,
        "scheduled_request_count": len(REQUEST_ORDER),
        "observed_request_count": len(results),
        "results": results,
    })
    metrics = case_metrics(results)
    write_json("case_metrics_v2.json", {"schema_version": "1.0.0", "status": status, "cases": metrics})
    selection = select_case(metrics)
    selection["schema_version"] = "1.0.0"
    if status != "COMPLETE":
        selection.update({"status": "INELIGIBLE_PARTIAL_EVIDENCE", "selected_case_id": None, "eligible_case_ids": []})
    write_json("selection_report_v2.json", selection)


def build_bundle() -> dict[str, object]:
    archive_path = OUTPUT_ROOT / EVIDENCE_ZIP_NAME
    expected_pre_manifest = set(EXPECTED_RUNTIME_OUTPUTS) - {"bundle_manifest_v2.json", EVIDENCE_ZIP_NAME}
    observed_pre_manifest = {
        path.name for path in OUTPUT_ROOT.iterdir()
        if path.is_file() and path.name not in {"bundle_manifest_v2.json", EVIDENCE_ZIP_NAME}
    }
    if observed_pre_manifest != expected_pre_manifest:
        raise DiagnosticFailure("P4_V2_OUTPUT_SET_INCOMPLETE", "runtime output set incomplete")
    members = [
        {"path": path.name, "size_bytes": path.stat().st_size, "sha256": sha256_file(path)}
        for path in sorted(OUTPUT_ROOT.iterdir())
        if path.is_file() and path.name in expected_pre_manifest
    ]
    write_json("bundle_manifest_v2.json", {
        "schema_version": "1.0.0",
        "members": members,
        "member_count": len(members),
        "raw_output_included": False,
    })
    with zipfile.ZipFile(archive_path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(OUTPUT_ROOT.iterdir()):
            if path.is_file() and path.name != EVIDENCE_ZIP_NAME:
                archive.write(path, arcname=path.name)
    return {"sha256": sha256_file(archive_path), "size_bytes": archive_path.stat().st_size}


def main() -> int:
    if OUTPUT_ROOT.exists() and any(OUTPUT_ROOT.iterdir()):
        print(canonical(safe_failure("P4_V2_OUTPUT_ROOT_NOT_EMPTY", "existing output root blocks attempt", "preflight")), file=sys.stderr)
        return 2
    if SCRATCH_ROOT.exists():
        shutil.rmtree(SCRATCH_ROOT)
    OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)
    SCRATCH_ROOT.mkdir(parents=True, exist_ok=True)
    initialize_not_run_reports()
    process: subprocess.Popen[str] | None = None
    threads: list[threading.Thread] = []
    results: list[dict[str, object]] = []
    current_stage = "preflight"
    terminal_error: dict[str, object] | None = None
    try:
        require_private_environment()
        write_json("runtime_source_identity_report_v2.json", {
            "schema_version": "1.0.0",
            "status": "PASSED",
            "source_main_commit": SOURCE_MAIN_COMMIT,
            "executed_runtime_script_sha256": globals().get("EXECUTED_RUNTIME_SCRIPT_SHA256"),
            "notebook_name": NOTEBOOK_NAME,
            "inspection_saved_version": INSPECTION_SAVED_VERSION,
            "inspection_evidence_sha256": INSPECTION_EVIDENCE_SHA256,
        })
        current_stage = "input_discovery"
        wheelhouse, snapshot = discover_inputs()
        current_stage = "model_snapshot_validation"
        write_json("model_snapshot_report_v2.json", validate_model_snapshot(snapshot))
        current_stage = "wheelhouse_validation"
        write_json("wheelhouse_report_v2.json", validate_wheelhouse(wheelhouse))
        current_stage = "runtime_installation"
        install_runtime(wheelhouse)
        current_stage = "runtime_import_closure"
        import_closure()
        current_stage = "worker_startup"
        process, _, _, threads = start_worker(snapshot)
        current_stage = "request_matrix"
        for index, case_id in enumerate(REQUEST_ORDER, start=1):
            results.append(perform_request(case_id, index))
            write_request_evidence(results)
        current_stage = "complete"
    except Exception as error:
        error_code = getattr(error, "error_code", "P4_V2_RUNTIME_FAILED")
        safe_message = getattr(error, "safe_message", type(error).__name__)
        terminal_error = safe_failure(error_code, safe_message, current_stage)
        write_request_evidence(results)
        write_json("failure_report_v2.json", terminal_error)
    finally:
        teardown_report = teardown(process, threads)
        write_json("worker_teardown_report_v2.json", teardown_report)
        cleanup_status = "PASSED"
        cleanup_error = None
        try:
            if SCRATCH_ROOT.exists():
                shutil.rmtree(SCRATCH_ROOT)
        except OSError as error:
            cleanup_status = "FAILED"
            cleanup_error = type(error).__name__
        write_json("scratch_cleanup_report_v2.json", {
            "schema_version": "1.0.0",
            "status": cleanup_status,
            "scratch_absent": not SCRATCH_ROOT.exists(),
            "error_type": cleanup_error,
        })
    if terminal_error is None:
        write_json("failure_report_v2.json", {
            "schema_version": "1.0.0",
            "status": "NOT_APPLICABLE",
            "error_code": None,
        })
    selection = json.loads((OUTPUT_ROOT / "selection_report_v2.json").read_text(encoding="utf-8"))
    summary_status = "PASSED" if terminal_error is None else "FAILED"
    write_json("p4_output_contract_diagnostic_summary_v2.json", {
        "schema_version": "1.0.0",
        "status": summary_status,
        "first_divergence": None if terminal_error is None else terminal_error["stage"],
        "reported_failure_code": None if terminal_error is None else terminal_error["error_code"],
        "selected_case_id": selection.get("selected_case_id"),
        "request_count": len(results),
        "counters": dict(COUNTERS),
        "inspection_saved_version": INSPECTION_SAVED_VERSION,
        "inspection_evidence_sha256": INSPECTION_EVIDENCE_SHA256,
    })
    write_text("human_report_v2.md", "\n".join([
        "# AuraGateway P4 Output-Contract Diagnostic V2",
        "",
        f"- Status: `{summary_status}`",
        f"- First divergence: `{None if terminal_error is None else terminal_error['stage']}`",
        f"- Failure code: `{None if terminal_error is None else terminal_error['error_code']}`",
        f"- Selected case: `{selection.get('selected_case_id')}`",
        f"- Model requests: `{COUNTERS['model_requests']}`",
        "- Raw prompts retained: `false`",
        "- Raw outputs retained: `false`",
        "- Measured A/B/C executed: `false`",
    ]))
    bundle = build_bundle()
    print("")
    print("=== P4_OUTPUT_CONTRACT_DIAGNOSTIC_V2_BEGIN ===")
    print(f"status={summary_status}")
    print(f"first_divergence={None if terminal_error is None else terminal_error['stage']}")
    print(f"reported_failure_code={None if terminal_error is None else terminal_error['error_code']}")
    print(f"selected_case_id={selection.get('selected_case_id')}")
    print(f"model_requests={COUNTERS['model_requests']}")
    print(f"evidence_zip={OUTPUT_ROOT / EVIDENCE_ZIP_NAME}")
    print(f"evidence_zip_sha256={bundle['sha256']}")
    print("measured_abc_execution=false")
    print("=== P4_OUTPUT_CONTRACT_DIAGNOSTIC_V2_END ===")
    return 0 if terminal_error is None else 1


if __name__ == "__main__":
    raise SystemExit(main())
