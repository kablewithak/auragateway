class DiagnosticFailure(RuntimeError):
    def __init__(self, error_code: str, safe_message: str) -> None:
        super().__init__(safe_message)
        self.error_code = error_code
        self.safe_message = safe_message


def canonical(payload: object) -> str:
    return json.dumps(payload, ensure_ascii=True, separators=(",", ":"), sort_keys=True)


def sha256_bytes(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sanitize_text(value: str, maximum: int = MAX_INSTALL_EXCERPT_CHARACTERS) -> str:
    bounded = value[-maximum:]
    replacements = {
        "/kaggle/input": "<input>",
        "/kaggle/working": "<working>",
        os.environ.get("HOME", ""): "<home>",
    }
    for source, replacement in replacements.items():
        if source:
            bounded = bounded.replace(source, replacement)
    return re.sub(
        r"(?i)\b(token|secret|password|api[_-]?key)\s*=\s*\S+",
        r"\1=<redacted>",
        bounded,
    )


def write_json(name: str, payload: object) -> None:
    path = OUTPUT_ROOT / name
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(canonical(payload), encoding="utf-8", newline="\n")
    temporary.replace(path)


def write_text(name: str, payload: str) -> None:
    path = OUTPUT_ROOT / name
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(payload.replace("\r\n", "\n"), encoding="utf-8", newline="\n")
    temporary.replace(path)


