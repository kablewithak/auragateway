{
  "schema_version": "1.0.0",
  "contract_id": "j7l-glm52-reference-named-tool-v1",
  "structured_output_mode": "FORCED_NAMED_TOOL",
  "wire": {
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "submit_reference_judgment",
          "description": "Return the complete J7L reference judgment for the visible case evidence. Do not reveal hidden chain-of-thought.",
          "parameters": {
            "additionalProperties": false,
            "properties": {
              "criterion_scores": {
                "additionalProperties": false,
                "properties": {
                  "clarity": {
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "completeness": {
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "evidence_grounding": {
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "safety": {
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "source_use": {
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "task_correctness": {
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "terminal_decision": {
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "task_correctness",
                  "evidence_grounding",
                  "source_use",
                  "terminal_decision",
                  "completeness",
                  "clarity",
                  "safety"
                ],
                "type": "object"
              },
              "evidence_references": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true,
                "type": "array"
              },
              "failure_labels": {
                "items": {
                  "enum": [
                    "STALE_SOURCE_SELECTED",
                    "FORBIDDEN_SOURCE_USED",
                    "MISSING_REQUIRED_SOURCE",
                    "UNSUPPORTED_CLAIM",
                    "INVALID_TERMINAL_DECISION",
                    "MISSING_CLARIFICATION",
                    "UNNECESSARY_CLARIFICATION",
                    "ESCALATION_BYPASSED",
                    "REFUSAL_BYPASSED",
                    "DUPLICATE_RETRIEVAL_EVIDENCE",
                    "REDUNDANT_FEEDBACK",
                    "UNRETAINED_FEEDBACK",
                    "CONTRADICTORY_STATE",
                    "NOISY_CONTEXT_DILUTION",
                    "CAPABILITY_MISMATCH",
                    "PROVIDER_FAILURE_UNHANDLED",
                    "BLIND_RETRY",
                    "INVALID_CITATION_ID",
                    "CITATION_UNSUPPORTED",
                    "STRUCTURED_OUTPUT_INVALID",
                    "PRIVACY_VIOLATION",
                    "TASK_INSUFFICIENT"
                  ]
                },
                "uniqueItems": true,
                "type": "array"
              },
              "rationale": {
                "maxLength": 3000,
                "minLength": 20,
                "type": "string"
              },
              "uncertainty_statement": {
                "maxLength": 1000,
                "type": [
                  "string",
                  "null"
                ]
              },
              "verdict": {
                "enum": [
                  "pass",
                  "fail"
                ],
                "type": "string"
              }
            },
            "required": [
              "criterion_scores",
              "failure_labels",
              "evidence_references",
              "rationale",
              "verdict",
              "uncertainty_statement"
            ],
            "type": "object"
          }
        }
      }
    ],
    "tool_choice": {
      "type": "function",
      "function": {
        "name": "submit_reference_judgment"
      }
    }
  },
  "response_format_present": false,
  "additional_model_tools_permitted": false,
  "tool_arguments_validation_contract": "J7LReferenceToolArgumentsV1",
  "host_bound_identity_fields": [
    "case_id",
    "request_id_sha256",
    "judge_binding_sha256"
  ],
  "model_may_supply_identity_fields": false,
  "hidden_reasoning_persisted": false
}
